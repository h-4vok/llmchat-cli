{
  "name": "llmchat-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Personal experimental alpha CLI for chat through a dedicated browser profile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/h-4vok/llmchat-cli.git"
  },
  "bugs": {
    "url": "https://github.com/h-4vok/llmchat-cli/issues"
  },
  "homepage": "https://github.com/h-4vok/llmchat-cli",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "llmchat": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test:compiled": "node --test",
    "test": "npm run build && npm run test:compiled",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.mjs\" \"test-support/**/*.mjs\"",
    "coverage": "npm run build && c8 --all --extension .ts --include \"src/**/*.ts\" --exclude-after-remap --check-coverage --lines 100 --functions 100 --branches 100 npm run test:compiled",
    "mutation": "stryker run",
    "check": "npm run format:check && npm run lint && npm test && npm run coverage",
    "start": "node dist/cli.js",
    "install:global": "npm run build && npm link",
    "uninstall:global": "npm unlink --global",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}
