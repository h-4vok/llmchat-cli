{
  "name": "llmchat-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "llmchat": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "start": "node dist/cli.js",
    "install:global": "npm run build && npm link",
    "uninstall:global": "npm unlink --global",
    "sloop": "node dist/dispatcher.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0"
  }
}
