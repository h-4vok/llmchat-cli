{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llmchat.reviewer-output/v1",
  "type": "object",
  "required": ["schema", "result", "summary", "evidence", "artifacts", "dispositions"],
  "properties": {
    "schema": { "type": "string", "const": "llmchat.reviewer-output/v1" },
    "result": { "type": "string", "enum": ["accepted", "changes_requested", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "body"],
        "properties": {
          "schema": {
            "type": "string",
            "enum": [
              "review.finding/v1",
              "review.note/v1",
              "review.summary/v1",
              "review.evidence/v1"
            ]
          },
          "id": { "type": "string", "pattern": "^[QS][0-9]+$" },
          "body": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "placement": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "type": "string", "const": "general" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "path", "commit", "side", "line"],
                "properties": {
                  "kind": { "type": "string", "const": "inline" },
                  "path": { "type": "string", "minLength": 1 },
                  "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "side": { "type": "string", "enum": ["LEFT", "RIGHT"] },
                  "line": { "type": "integer", "minimum": 1 },
                  "start_line": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["continue", "resolve"] }
    }
  },
  "additionalProperties": false
}
