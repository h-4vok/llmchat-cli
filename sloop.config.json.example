{
  "baseBranch": "staging",
  "workerCommand": {
    "command": "codex",
    "args": ["exec", "--sandbox", "danger-full-access"],
    "timeoutMs": 600000
  },
  "staffReviewCommand": {
    "command": "codex",
    "args": ["exec", "--sandbox", "danger-full-access"],
    "timeoutMs": 600000
  },
  "qaCommand": {
    "command": "codex",
    "args": ["exec", "--sandbox", "danger-full-access"],
    "timeoutMs": 600000
  },
  "requiredPrChecks": ["pr-checks"],
  "checkPollIntervalMs": 5000,
  "checkTimeoutMs": 900000,
  "evidencePollIntervalMs": 2000,
  "evidenceTimeoutMs": 60000,
  "workerLeaseMs": 900000,
  "maxReviewRounds": 10,
  "logRoleInvocation": true,
  "lockTtlMs": 900000
}
